# Copy to /etc/market-sentinel/market-sentinel-health.env as root with mode 0600.
# This file is loaded only by the least-privilege health probe service. Keep it
# free of the admin API token and all venue credentials.

# Use the same independently generated observability value configured in the
# web service environment. Generate with: openssl rand -hex 32
MARKET_SENTINEL_OBSERVABILITY_TOKEN=
