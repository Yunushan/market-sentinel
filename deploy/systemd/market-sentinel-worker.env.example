# Copy to /etc/market-sentinel/market-sentinel-worker.env, owned by root and
# mode 0600. The unattended worker needs only credentials scoped to read market
# prices or wallet activity. Do not copy the web service environment wholesale.
#
# Polymarket alert prices and wallet activity use public endpoints and normally
# require no credential. Uncomment only the read-scoped keys needed by enabled
# adapters. If a venue cannot issue a read-only credential, leave that venue's
# unattended alerts disabled; the worker will report a partial failure instead
# of receiving an order-signing secret.

# Required. Replace this placeholder with the exact 40-hex release commit
# installed at /opt/market-sentinel before enabling either worker timer. Worker
# state and deployment evidence are rejected when this does not match the
# reviewed deployment revision.
MARKET_SENTINEL_SOURCE_REVISION=0123456789abcdef0123456789abcdef01234567

# CONTEXT_API_KEY=
# CRYPTO_COM_PREDICTIONS_API_KEY=
# DFLOW_API_KEY=
# DRAFTKINGS_PREDICTIONS_API_KEY=
# FANDUEL_PREDICTS_API_KEY=
