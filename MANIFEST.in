include .env.example
include CONTRIBUTING.md
include CODE_SIGNING_POLICY.md
include GOAL.md
include LICENSE
include PRIVACY.md
include README.md
include SECURITY.md
include requirements.lock
include requirements-bootstrap.lock
include requirements-build.lock
include requirements-live.lock
include requirements-security.lock
include requirements-test.lock
include requirements*.txt
include *.bat
include marketsentinel.png
recursive-include .github *.yml *.yaml
recursive-include assets *.ico *.png *.svg
recursive-exclude [dD][aA][tT][aA] *
include data/config.example.json
recursive-include deploy *
recursive-include docs *.md
recursive-include frontend *.css *.html *.json *.mjs *.png *.ts *.tsx
recursive-include scripts *.py
recursive-include scripts *.ps1
