prune frontend/dist
prune frontend/.cache
prune frontend/node_modules
prune frontend/.test-dist
prune frontend/test-results
prune frontend/playwright-report
global-exclude *.[pP][eE][mM] *.[kK][eE][yY] *.[pP][fF][xX] *.[pP]12 *.[jJ][kK][sS] .[eE][nN][vV] .[eE][nN][vV].* *.[eE][nN][vV] *.[eE][nN][vV].*
include .env.example
recursive-include deploy *.env.example
